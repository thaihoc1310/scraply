    <!-- About Screen -->
    <string name="about_title">Về Scraply</string>
    <string name="about_intro">Scraply được tạo ra với một tầm nhìn đơn giản nhưng đầy tâm huyết: giúp bạn ghi lại, sắp đặt và nâng niu những khoảnh khắc quý giá nhất trong cuộc đời dưới dạng một cuốn sổ lưu niệm thủ công số.\n\nGiữa một thế giới số vội vã nơi ký ức dễ dàng bị chìm lấp trong những dòng thông tin vô tận, Scraply mang đến cho bạn một khoảng lặng sáng tạo đầy nghệ thuật. Bạn có thể tự tay chụp và cắt những con tem độc đáo quanh mình, viết lên những dòng suy ngẫm chân thật và tự do sắp xếp chúng trên các trang giấy cũ đầy hoài niệm. Mỗi trang sổ là một tác phẩm phản chiếu hành trình cá nhân của riêng bạn. Cảm ơn bạn đã lựa chọn Scraply để lưu giữ những câu chuyện tuyệt đẹp của mình!</string>
    <string name="about_version">Phiên bản 0.3.5 (25)</string>
